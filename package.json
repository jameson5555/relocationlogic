{
  "name": "relocationlogic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:production": "NODE_ENV=production next start",
    "lint": "eslint",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "postexport": "node scripts/generate-salary-pages.js && node scripts/fix-export-indexes.js",
    "export": "npm run generate-sitemap && NEXT_EXPORT=true next build && npm run postexport"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
