# Minimal rules to serve static-exported .html files for extensionless URLs
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If a request ends with .html, redirect to the canonical trailing-slash path.
  # This ensures client navigation uses directory-style URLs (served from index.html)
  # and avoids client attempts to fetch `*.html/__next._tree.txt` which don't exist
  # on a static export.
  RewriteCond %{REQUEST_URI} ^/(.+)\.html$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^(.+?)\.html$ https://%{HTTP_HOST}/$1/ [L,R=301]

  # Serve/rewite client requests for missing Next tree files under .html paths
  # Example: /salary/x/y.html/__next._tree.txt -> internally serve /salary/x/y.html
  RewriteCond %{REQUEST_URI} ^(.+\.html)/__next\._tree\.txt$
  RewriteRule ^ %1 [L]

  # If the request maps to a real file or directory, serve it.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If a directory is requested and an index.html exists, serve it.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # If a path without extension matches an existing .html file, serve it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-RelocationLogic-Deploy "static-export"
</IfModule>

# Prevent browsers from caching something you may want to change quickly
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>
