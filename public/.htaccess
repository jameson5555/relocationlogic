# Minimal rules to serve static-exported .html files for extensionless URLs
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If a trailing-slash URL corresponds to an existing .html file, redirect to it.
  # Use a capture that excludes the leading slash so we don't produce a double-slash.
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  # Redirect using the actual host to avoid accidental double-slash protocol-relative URLs
  RewriteRule ^(.+?)/$ https://%{HTTP_HOST}/$1.html [L,R=301]

  # If the request maps to a real file or directory, serve it.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If a directory is requested and an index.html exists, serve it.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # If a path without extension matches an existing .html file, serve it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-RelocationLogic-Deploy "static-export"
</IfModule>

# Prevent browsers from caching something you may want to change quickly
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>
